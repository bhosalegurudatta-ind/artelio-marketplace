# Copy this file to .env.local (same folder) and fill in YOUR values. No quotes, no square brackets, no spaces.

# Supabase: Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Razorpay (Test Mode): Settings -> API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Gemini (free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Secret that lets the daily job release held payouts. Make up a long random string.
# Example: openssl rand -hex 32   (or any long random text)
CRON_SECRET=replace-with-a-long-random-string
