# ==============================================================================
# ARTELIO MARKETPLACE • ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in your keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN
# ------------------------------------------------------------------------------
# In production, set this to your custom domain (e.g., https://artelio.in)
NEXT_PUBLIC_SITE_URL=https://artelio.in

# ------------------------------------------------------------------------------
# 2. SUPABASE (Database & Authentication)
# Settings -> API: Project URL & API Keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY (Switch from Test to Live)
# Razorpay Dashboard -> Settings -> API Keys
# Test Mode: starts with 'rzp_test_...'
# Production / Live Mode: toggle mode to 'Live' on dashboard, starts with 'rzp_live_...'
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-live-razorpay-secret

# ------------------------------------------------------------------------------
# 4. LIVE WHATSAPP ART CONCIERGE
# Enter the concierge support WhatsApp phone number with country code (e.g. 919876543210)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAILS (Resend)
# Create a free account at https://resend.com
# For testing: use 'onboarding@resend.dev' as sender.
# For production: verify your domain (e.g. artelio.in) in Resend Domains tab.
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Artelio Atelier <concierge@artelio.in>

# ------------------------------------------------------------------------------
# 6. GOOGLE GEMINI AI (Spatial Visualizer & Listing Assistant)
# Get your API key from https://aistudio.google.com/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 7. PLATFORM CRON AUTOMATION (Escrow Payout Release)
# Secret that lets the automated job release held payouts safely.
# Generate via: openssl rand -hex 32
# ------------------------------------------------------------------------------
CRON_SECRET=replace-with-a-long-random-string
